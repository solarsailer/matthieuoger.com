{
  "name": "matthieuoger.com",
  "version": "7.0.0",
  "description": "Website, blog and portfolio.",
  "license": "UNLICENSED",
  "private": true,
  "repository": "https://github.com/solarsailer/matthieuoger.com/",
  "author": {
    "name": "Matthieu Oger",
    "url": "https://matthieuoger.com/"
  },
  "scripts": {},
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "prettier": "^3.10.1",
    "prettier-plugin-go-template": "^0.0.15"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-go-template"
    ],
    "overrides": [
      {
        "files": [
          "*.html"
        ],
        "options": {
          "parser": "go-template"
        }
      }
    ],
    "goTemplateBracketSpacing": true,
    "htmlWhitespaceSensitivity": "ignore",
    "semi": false,
    "trailingComma": "none"
  }
}
